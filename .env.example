# Signum Decoder local runtime configuration
# Copy to .env only if your local launcher loads dotenv; never commit real credentials.

# Model adapter: "llama" (default, the local OpenAI-compatible endpoint below) or "mock"
# (deterministic fixture reading, no model server needed).
SIGNUM_DECODE_PROVIDER=llama

# Local OpenAI-compatible llama.cpp / llama-swap endpoint.
SIGNUM_DECODE_BASE_URL=http://127.0.0.1:8082
SIGNUM_DECODE_MODEL=signum-vision
SIGNUM_DECODE_PROVIDER_VERSION=qwen3.8-27b.signum-vision.decode.v2
SIGNUM_DECODE_TIMEOUT_MS=360000
SIGNUM_DECODE_MAX_TOKENS=1400

# Optional archival-review overrides. By default review reuses the local Decode endpoint/model.
SIGNUM_REVIEW_BASE_URL=http://127.0.0.1:8082
SIGNUM_REVIEW_MODEL=signum-vision
SIGNUM_REVIEW_TIMEOUT_MS=180000
SIGNUM_REVIEW_PROVIDER_VERSION=qwen3.8-27b.signum-vision.img1024.short48.v2

# Thin local HTTP decode adapter. Keep loopback-only unless the server is explicitly hardened.
SIGNUM_DECODE_HOST=127.0.0.1
SIGNUM_DECODE_PORT=5174

# Pino log level (for example: trace, debug, info, warn, error, fatal).
SIGNUM_LOG_LEVEL=info

# Optional: required only for Meta Ad Library ingestion. Leave empty otherwise.
FB_ACCESS_TOKEN=
